{
  "name": "anuncios-multiplataforma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de anuncios multiplataforma: cadastro unico de produto, publicacao em Mercado Livre, OLX, Facebook e kits manuais.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --experimental-sqlite --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --experimental-sqlite --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "seed": "node --experimental-sqlite --env-file-if-exists=.env --import tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
