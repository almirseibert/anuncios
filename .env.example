# Copie para .env e preencha. Nada aqui e obrigatorio para rodar em dry-run.
# cp .env.example .env

# ---------------------------------------------------------------- servidor
PORT=3000
# Em producao (Easypanel/Docker) use 0.0.0.0; local, 127.0.0.1.
HOST=127.0.0.1
# URL que a INTERNET alcanca. As plataformas baixam as fotos por ela:
# com localhost, nenhuma foto chega. Em producao: https://seu-app.easypanel.host
PUBLIC_URL=http://127.0.0.1:3000

# Simulacao: monta o payload e grava tudo, mas nao chama as plataformas.
# Deixe true ate validar as credenciais de cada canal.
DRY_RUN=true

# ---------------------------------------------------------------- acesso ao painel
# Com ADMIN_PASS preenchido o painel passa a pedir usuario e senha (Basic Auth).
# OBRIGATORIO se o app estiver exposto na internet: nao ha outra protecao.
# Ficam livres de senha, de proposito: /uploads (as plataformas baixam as fotos),
# /feeds (tem token proprio), /produtos/:id (pagina publica) e /m (envio pelo celular).
ADMIN_USER=admin
ADMIN_PASS=
# Com PUBLIC_URL publica e ADMIN_PASS vazio o servidor se recusa a subir.
# Use isto so se voce quer mesmo o painel aberto na internet.
# ALLOW_NO_AUTH=true

# ---------------------------------------------------------------- seus dados
# Entram no rodape dos posts manuais e no link do WhatsApp.
SELLER_NAME=
# Apenas digitos, com DDD. Ex.: 51999998888
SELLER_PHONE=
SELLER_CEP=
SELLER_CITY=
SELLER_UF=

# ---------------------------------------------------------------- Gemini (texto e foto)
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Modelo de imagem usado pelo botao "Melhorar foto".
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------------------------------------------------------------- Mercado Livre
# https://developers.mercadolivre.com.br/devcenter
# O redirect precisa ser HTTPS fora de localhost.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://127.0.0.1:3000/oauth/mercadolivre/callback
ML_SITE_ID=MLB

# ---------------------------------------------------------------- OLX (feed de autoupload)
# Exige parceria aprovada. O token protege a URL do feed:
# https://SEU_DOMINIO/feeds/olx.xml?token=...
OLX_FEED_TOKEN=
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
OLX_ACCESS_TOKEN=

# ---------------------------------------------------------------- Meta (catalogo Facebook/Instagram)
# Exige Business Manager: publica como loja, nao como pessoa fisica.
FB_APP_ID=
FB_APP_SECRET=
FB_CATALOG_ID=
# Token de usuario do sistema (nao expira em 60 dias).
FB_ACCESS_TOKEN=
FB_API_VERSION=v21.0

# ---------------------------------------------------------------- imagens
# Lado maior apos o tratamento automatico. 1600 cobre o recomendado de todos os canais.
IMAGE_MAX_SIDE=1600
IMAGE_QUALITY=85

# ---------------------------------------------------------------- caminhos (Docker cuida disso)
# DATA_DIR=/app/data
# UPLOADS_DIR=/app/data/uploads
# DB_FILE=/app/data/anuncios.db
